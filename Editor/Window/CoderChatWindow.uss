:root {
    --chat-bg: #17191d;
    --surface: #202329;
    --surface-raised: #272b32;
    --surface-muted: #1c1f24;
    --border: #383d46;
    --border-strong: #4a515d;
    --text: #e5e8ed;
    --text-muted: #9da4ae;
    --accent: #5f91e8;
    --accent-strong: #74a4f5;
    --success: #57b881;
    --warning: #e0ad55;
    --danger: #db6a72;
    --user: #26384f;
    --assistant: #22262c;
    --system: #242a25;
}

.coder-chat-root {
    flex-grow: 1;
    min-width: 360px;
    background-color: var(--chat-bg);
    color: var(--text);
}

.connection-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 8px 10px;
    background-color: var(--surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.connection-summary,
.connection-actions,
.composer-toolbar,
.composer-left,
.composer-right,
.reference-chips,
.settings-row,
.interaction-actions,
.message-header,
.reference-row,
.tool-header {
    flex-direction: row;
    align-items: center;
}

.connection-summary { flex-grow: 1; min-width: 140px; }
.connection-copy { flex-grow: 1; margin-left: 8px; }
.connection-actions { flex-shrink: 1; justify-content: flex-end; }
.connection-actions > * { margin-left: 5px; }

.status-dot {
    width: 9px;
    height: 9px;
    border-radius: 5px;
    background-color: var(--text-muted);
}
.status-dot.state-idle { background-color: var(--success); }
.status-dot.state-running,
.status-dot.state-syncing,
.status-dot.state-connecting { background-color: var(--accent); }
.status-dot.state-waiting { background-color: var(--warning); }
.status-dot.state-error { background-color: var(--danger); }

.status-label { font-size: 12px; -unity-font-style: bold; }
.meta-label { margin-top: 2px; font-size: 10px; color: var(--text-muted); }

.badge {
    margin-left: 7px;
    padding: 2px 6px;
    border-radius: 8px;
    background-color: var(--surface-raised);
    color: var(--text-muted);
    font-size: 9px;
    -unity-font-style: bold;
}

.settings-host {
    background-color: var(--surface-muted);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}
.settings-foldout { padding: 4px 10px 8px 10px; }
.settings-grid { margin-top: 5px; }
.settings-row { margin-top: 4px; }
.settings-row > .unity-base-field { flex-grow: 1; }
.settings-row > .unity-button { margin-left: 5px; }
.settings-note { margin-top: 5px; color: var(--text-muted); font-size: 10px; white-space: normal; }
.settings-preamble { min-height: 70px; max-height: 160px; }

.transcript-shell { flex-grow: 1; position: relative; min-height: 160px; }
.transcript-list { flex-grow: 1; background-color: var(--chat-bg); border-width: 0; }
.transcript-list .unity-collection-view__item { padding: 0; }
.new-messages-button {
    position: absolute;
    right: 16px;
    bottom: 12px;
    min-width: 130px;
    height: 28px;
    background-color: var(--accent);
    color: #ffffff;
    border-radius: 14px;
}

.message-row { padding: 5px 10px; }
.message-bubble {
    padding: 9px 11px;
    border-width: 1px;
    border-color: var(--border);
    border-radius: 7px;
    background-color: var(--assistant);
}
.message-row.role-user .message-bubble { margin-left: 28px; background-color: var(--user); border-color: #345274; }
.message-row.role-assistant .message-bubble { margin-right: 18px; }
.message-row.role-system .message-bubble { background-color: var(--system); border-color: #354438; }
.message-row.role-error .message-bubble { background-color: #3a2226; border-color: #76424a; }
.message-row.role-tool .message-bubble { background-color: #29252f; border-color: #4e425f; }
.message-role { flex-grow: 1; font-size: 11px; -unity-font-style: bold; color: var(--accent-strong); }
.message-time { font-size: 9px; color: var(--text-muted); }
.message-body { margin-top: 5px; white-space: normal; color: var(--text); }
.message-streaming { margin-left: 6px; color: var(--accent-strong); font-size: 9px; }
.message-thinking { margin-top: 6px; color: var(--text-muted); }
.message-thinking .unity-foldout__content { padding-left: 8px; }

.tool-list { margin-top: 7px; }
.tool-card {
    margin-top: 4px;
    padding: 5px 7px;
    border-left-width: 2px;
    border-left-color: var(--accent);
    background-color: #1b1e23;
    border-radius: 3px;
}
.tool-card.failed { border-left-color: var(--danger); }
.tool-title { flex-grow: 1; font-size: 10px; -unity-font-style: bold; }
.tool-meta { font-size: 9px; color: var(--text-muted); }
.tool-code { margin-top: 4px; padding: 5px; background-color: #121418; color: #c8d0dc; font-size: 10px; white-space: normal; }

.message-references { margin-top: 6px; flex-direction: row; flex-wrap: wrap; }
.message-reference-chip,
.reference-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 5px;
    margin-top: 4px;
    padding: 3px 6px;
    border-radius: 10px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--border-strong);
}
.reference-chip.unavailable { border-color: var(--danger); color: var(--danger); }
.reference-remove-button { margin-left: 4px; min-width: 18px; width: 18px; height: 18px; padding: 0; }

.interactions-container {
    max-height: 320px;
    padding: 0 10px;
    background-color: var(--chat-bg);
}
.interaction-card {
    margin-top: 6px;
    padding: 9px;
    background-color: #29261f;
    border-width: 1px;
    border-color: #6f5c37;
    border-radius: 6px;
}
.interaction-header { flex-direction: row; align-items: center; margin-bottom: 5px; }
.interaction-title { flex-grow: 1; -unity-font-style: bold; color: var(--warning); }
.interaction-copy { white-space: normal; }
.interaction-scroll { max-height: 190px; margin-top: 4px; padding: 5px; background-color: #1c1b18; }
.interaction-input { margin-top: 6px; min-height: 42px; max-height: 100px; }
.interaction-actions { margin-top: 7px; justify-content: flex-end; flex-wrap: wrap; }
.interaction-actions > * { margin-left: 5px; margin-top: 3px; }
.interaction-error { margin-top: 5px; color: var(--danger); white-space: normal; }

.composer-panel {
    margin: 8px 10px 10px 10px;
    padding: 8px;
    min-height: 116px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 7px;
}
.reference-chips { flex-wrap: wrap; }
.composer-caption { font-size: 10px; color: var(--text-muted); margin-bottom: 3px; }
.composer-input { min-height: 66px; max-height: 180px; }
.composer-input .unity-text-input { white-space: normal; }
.composer-feedback { margin-top: 4px; color: var(--danger); white-space: normal; }
.composer-toolbar { margin-top: 7px; justify-content: space-between; flex-wrap: wrap; }
.composer-left { flex-grow: 1; flex-wrap: wrap; }
.composer-right { justify-content: flex-end; }
.composer-left > *,
.composer-right > * { margin-right: 5px; margin-top: 3px; }
.agent-field { min-width: 135px; max-width: 220px; }
.effort-field { width: 92px; }
.send-button { min-width: 82px; background-color: var(--accent); color: #ffffff; }
.send-button.stop { background-color: var(--danger); }

.empty-state { flex-grow: 1; align-items: center; justify-content: center; padding: 24px; }
.empty-title { font-size: 16px; -unity-font-style: bold; }
.empty-copy { margin-top: 6px; color: var(--text-muted); white-space: normal; -unity-text-align: middle-center; }
.reference-picker-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background-color: rgba(8, 10, 13, 0.78);
}
.reference-picker-panel {
    width: 92%;
    height: 78%;
    min-width: 320px;
    min-height: 300px;
    max-width: 860px;
    padding: 10px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border-strong);
    border-radius: 8px;
}
.reference-picker-header,
.reference-picker-tabs,
.reference-result-row {
    flex-direction: row;
    align-items: center;
}
.reference-picker-header { justify-content: space-between; margin-bottom: 6px; }
#reference-picker-title { flex-grow: 1; font-size: 14px; -unity-font-style: bold; }
.reference-picker-tabs { margin-bottom: 6px; }
.reference-picker-tabs > * { margin-right: 5px; }
.reference-picker-tabs .selected { background-color: var(--accent); color: #ffffff; }
#reference-search { margin-bottom: 4px; }
.reference-picker-status { margin: 3px 0; color: var(--text-muted); font-size: 10px; white-space: normal; }
.reference-results { flex-grow: 1; margin-top: 4px; background-color: var(--surface-muted); border-width: 1px; border-color: var(--border); }
.reference-result-row { height: 44px; padding: 4px 7px; border-bottom-width: 1px; border-bottom-color: var(--border); }
.reference-result-copy { flex-grow: 1; overflow: hidden; }
.reference-result-label { -unity-font-style: bold; }
.reference-result-detail { margin-top: 2px; color: var(--text-muted); font-size: 9px; overflow: hidden; white-space: nowrap; }

.fatal-error { padding: 12px; color: var(--danger); white-space: normal; }
.hidden { display: none; }
