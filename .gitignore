# Local validation workspace: disposable Unity projects, test results and evidence.
# Keep it on your machine; CI recreates what it needs.
.validation/

# Generated project and IDE files
*.csproj
!Tools~/CSharpSyntaxCheck/*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vscode/
.idea/
.vs/

# Python environments and caches (Broker~, Sidecar~, Tools~)
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/

# Secrets and local runtime data
.env
.env.*
*.sqlite3
*.sqlite3-*
*.log

# Local tooling and operating-system files
.mcp-indexer/
.DS_Store
Thumbs.db
desktop.ini
